{
  "name": "strapi-plugin-dynamic-enumeration-field",
  "version": "2.3.0",
  "description": "Custom field to create dynamic enumerations",
  "strapi": {
    "name": "dynamic-enumeration",
    "description": "Custom field to create dynamic enumerations",
    "kind": "plugin",
    "displayName": "Dynamic Enumeration Field"
  },
  "scripts": {
    "build": "tsx build.ts",
    "dev": "tsx watch --include './admin/**/*' --include './server/**/*' build.ts "
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "dependencies": {
    "@strapi/design-system": "2.0.0-rc.30",
    "@strapi/icons": "2.0.0-rc.30",
    "@strapi/strapi": "^5.24.1",
    "immer": "^10.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "7.1.11",
    "react-redux": "9.2.0",
    "react-router-dom": "^6.27.0",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@strapi/pack-up": "^5.1.0",
    "@strapi/typescript-utils": "^5.24.1",
    "@types/react": "^19.1.14",
    "@types/react-dom": "^19.1.9",
    "rollup-plugin-node-externals": "^8.1.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alanzdr/strapi-plugin-dynamic-enumeration-field.git"
  },
  "author": {
    "name": "Alanderson Zelindro da Rosa",
    "url": "https://github.com/alanzdr"
  },
  "maintainers": [
    {
      "name": "Alanderson Zelindro da Rosa",
      "url": "https://github.com/alanzdr"
    }
  ],
  "engines": {
    "node": ">=16.0.0 <=22.x.x",
    "npm": ">=6.0.0"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.17.1"
}